{
  "figure_id": "6.1.3.2.1.1",
  "title": "The 5GSM sublayer states for PDU session handling in the UE (overview)",
  "type": "STATE_TRANSITION",
  "content": {
    "states": [
      "PDU SESSION INACTIVE",
      "PDU SESSION INACTIVE PENDING",
      "PDU SESSION ACTIVE PENDING",
      "PDU SESSION ACTIVE",
      "PDU SESSION MODIFICATION PENDING"
    ],
    "transitions": [
      {
        "from": "PDU SESSION INACTIVE",
        "to": "PDU SESSION ACTIVE PENDING",
        "conditions": [
          "PDU SESSION ESTABLISHMENT REQUEST",
          "or",
          "PDU SESSION RESUME REQUEST"
        ]
      },
      {
        "from": "PDU SESSION INACTIVE PENDING",
        "to": "PDU SESSION INACTIVE",
        "conditions": [
          "PDU SESSION RELEASE COMMAND",
          "or",
          "PDU SESSION MODIFICATION COMMAND REJECT including cause value = 43"
        ]
      },
      {
        "from": "PDU SESSION INACTIVE PENDING",
        "to": "PDU SESSION ACTIVE",
        "conditions": [
          "PDU SESSION RELEASE REJECT"
        ]
      },
      {
        "from": "PDU SESSION ACTIVE PENDING",
        "to": "PDU SESSION INACTIVE",
        "conditions": [
          "PDU SESSION ESTABLISHMENT REJECT",
          "or",
          "PDU SESSION AUTHENTICATION REJECT"
        ]
      },
      {
        "from": "PDU SESSION ACTIVE PENDING",
        "to": "PDU SESSION ACTIVE",
        "conditions": [
          "PDU SESSION ESTABLISHMENT ACCEPT"
        ]
      },
      {
        "from": "PDU SESSION ACTIVE",
        "to": "PDU SESSION INACTIVE PENDING",
        "conditions": [
          "PDU SESSION RELEASE COMMAND"
        ]
      },
      {
        "from": "PDU SESSION ACTIVE",
        "to": "PDU SESSION MODIFICATION PENDING",
        "conditions": [
          "PDU SESSION MODIFICATION REQUEST"
        ]
      },
      {
        "from": "PDU SESSION MODIFICATION PENDING",
        "to": "PDU SESSION ACTIVE",
        "conditions": [
          "PDU SESSION MODIFICATION COMMAND",
          "or",
          "PDU SESSION MODIFICATION REJECT including cause value /= 43"
        ]
      },
      {
        "from": "PDU SESSION ACTIVE",
        "to": "PDU SESSION INACTIVE",
        "conditions": [
          "PDU SESSION RELEASE COMMAND",
          "or",
          "PDU SESSION MODIFICATION COMMAND REJECT including cause value = 43"
        ]
      },
      {
        "from": "PDU SESSION ACTIVE",
        "to": "PDU SESSION ACTIVE",
        "conditions": [
          "PDU SESSION MODIFICATION REQUEST",
          "PDU SESSION ESTABLISHMENT REQUEST",
          "or",
          "PDU SESSION MODIFICATION COMPLETE",
          "or",
          "PDU SESSION MODIFICATION COMMAND REJECT including cause value /= 43"
        ]
      }
    ],
    "entities": [],
    "messages": [],
    "fields": [],
    "notes": [
      "NOTE 1: Not all possible transitions are shown in this figure.",
      "NOTE 2: Some transitions shown in this figure are not applicable to the MA PDU session."
    ]
  }
