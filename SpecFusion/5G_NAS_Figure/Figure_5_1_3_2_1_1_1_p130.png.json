{
  "figure_id": "5.1.3.2.1.1.1",
  "title": "5GMM main states in the UE",
  "type": "STATE_TRANSITION",
  "content": {
    "states": [
      "5GMM-NULL",
      "5GMM-DEREGISTERED",
      "5GMM-DEREGISTERED-INITIATED",
      "5GMM-REGISTERED",
      "5GMM-REGISTERED-INITIATED",
      "5GMM-SERVICE-REQUEST-INITIATED",
      "Any state"
    ],
    "transitions": [
    {
      "from": "5GMM-NULL",
      "to": "5GMM-DEREGISTERED",
      "trigger": "enable N1 mode"
    },
    {
      "from": "5GMM-DEREGISTERED",
      "to": "5GMM-NULL",
      "trigger": "disable N1 mode"
    },
    {
      "from": "5GMM-DEREGISTERED-INITIATED",
      "to": "5GMM-DEREGISTERED",
      "trigger": "Deregistration accepted"
    },
    {
      "from": "5GMM-REGISTERED",
      "to": "5GMM-DEREGISTERED-INITIATED",
      "trigger": "Deregistration requested (not power off)"
    },
    {
      "from": "5GMM-REGISTERED",
      "to": "5GMM-DEREGISTERED",
      "trigger": [
        "NW-initiated deregistration requested",
        "Local deregistration"
      ]
    },
    {
      "from": "5GMM-DEREGISTERED",
      "to": "5GMM-REGISTERED-INITIATED",
      "trigger": "Initial registration requested"
    },
    {
      "from": "Any state",
      "to": "5GMM-DEREGISTERED",
      "trigger": "Deregistration requested (power off)"
    },
    {
      "from": "5GMM-REGISTERED-INITIATED",
      "to": "5GMM-REGISTERED",
      "trigger": [
        "Initial registration accepted",
        "Non-initial registration accepted",
        "Non-initial registration rejected or failed (other causes)"
      ]
    },
    {
      "from": "5GMM-REGISTERED-INITIATED",
      "to": "5GMM-DEREGISTERED",
      "trigger": [
        "Initial registration rejected or failed",
        "Non-initial registration rejected (e.g. #3, #6, #7)",
        "NW-initiated deregistration requested"
      ]
    },
    {
      "from": "5GMM-REGISTERED",
      "to": "5GMM-SERVICE-REQUEST-INITIATED",
      "trigger": "SR initiated"
    },
    {
      "from": "5GMM-SERVICE-REQUEST-INITIATED",
      "to": "5GMM-REGISTERED",
      "trigger": [
        "SR accepted",
        "SR rejected or failed (e.g. #22, #28)"
      ]
    },
    {
      "from": "5GMM-REGISTERED",
      "to": "5GMM-REGISTERED-INITIATED",
      "trigger": "Non-initial registration requested"
    }
  ]
}
}